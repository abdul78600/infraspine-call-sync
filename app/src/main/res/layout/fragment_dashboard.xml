<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_overview_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/dashboard_overview_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Stats grid: tap a card to jump to the matching recordings list -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:useDefaultMargins="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTotal"
                    style="@style/StatCard"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="@color/primary_variant">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:id="@+id/textTotalCount" style="@style/StatValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" />
                        <TextView style="@style/StatLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/total_recordings" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPending"
                    style="@style/StatCard"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="@color/status_pending">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:id="@+id/textPendingCount" style="@style/StatValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/status_pending" />
                        <TextView style="@style/StatLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pending_sync" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSynced"
                    style="@style/StatCard"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="@color/status_synced">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:id="@+id/textSyncedCount" style="@style/StatValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/status_synced" />
                        <TextView style="@style/StatLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/synced_count" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFailed"
                    style="@style/StatCard"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="@color/status_failed">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:id="@+id/textFailedCount" style="@style/StatValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/status_failed" />
                        <TextView style="@style/StatLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/failed_count" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUnmatched"
                    style="@style/StatCard"
                    android:layout_columnWeight="1"
                    android:layout_columnSpan="2"
                    android:layout_margin="4dp"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    app:rippleColor="@color/status_unmatched">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:id="@+id/textUnmatchedCount" style="@style/StatValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/status_unmatched" />
                        <TextView style="@style/StatLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="@string/unmatched_label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Sync status -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="2dp"
                app:contentPadding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sync_status_label"
                            style="@style/StatLabel" />

                        <TextView
                            android:id="@+id/textSyncStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sync_now"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSyncNow"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sync_now" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonScanNow"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/scan_now" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonViewRecordings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/view_recordings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonViewCallHistory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/view_call_history" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSettings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/settings" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
