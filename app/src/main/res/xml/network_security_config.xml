<?xml version="1.0" encoding="utf-8"?>
<!--
  The CRM Server URL is entered by the user at runtime (Settings) and may point to:
    - a LAN development server reachable only over plain HTTP (e.g. http://192.168.x.x:5000)
    - a production server reachable over HTTPS (e.g. https://crm.example.com)

  We cannot whitelist a specific host (the host isn't known at build time and changes
  per deployment), so cleartext is allowed at the base-config level. This does not
  weaken HTTPS connections: when the configured URL is "https://...", OkHttp/Retrofit
  always negotiates TLS and certificate validation is enforced as normal — this config
  only stops the platform from refusing to *attempt* a plaintext connection when the
  user has explicitly pointed the app at an http:// endpoint.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
