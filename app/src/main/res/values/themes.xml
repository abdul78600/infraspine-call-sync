<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InfraSpineCallSync" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/secondary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.InfraSpineCallSync.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="StatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="StatValue">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="StatLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="SearchHintText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="FilterChip.Base" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">11sp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">26dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
    </style>

    <style name="FilterChip.All" parent="FilterChip.Base">
        <item name="chipBackgroundColor">@color/chip_bg_all</item>
        <item name="chipStrokeColor">@color/chip_stroke_all</item>
        <item name="android:textColor">@color/chip_text_all</item>
    </style>

    <style name="FilterChip.Pending" parent="FilterChip.Base">
        <item name="chipBackgroundColor">@color/chip_bg_pending</item>
        <item name="chipStrokeColor">@color/chip_stroke_pending</item>
        <item name="android:textColor">@color/chip_text_pending</item>
    </style>

    <style name="FilterChip.Synced" parent="FilterChip.Base">
        <item name="chipBackgroundColor">@color/chip_bg_synced</item>
        <item name="chipStrokeColor">@color/chip_stroke_synced</item>
        <item name="android:textColor">@color/chip_text_synced</item>
    </style>

    <style name="FilterChip.Failed" parent="FilterChip.Base">
        <item name="chipBackgroundColor">@color/chip_bg_failed</item>
        <item name="chipStrokeColor">@color/chip_stroke_failed</item>
        <item name="android:textColor">@color/chip_text_failed</item>
    </style>

    <style name="FilterChip.Unmatched" parent="FilterChip.Base">
        <item name="chipBackgroundColor">@color/chip_bg_unmatched</item>
        <item name="chipStrokeColor">@color/chip_stroke_unmatched</item>
        <item name="android:textColor">@color/chip_text_unmatched</item>
    </style>
</resources>
